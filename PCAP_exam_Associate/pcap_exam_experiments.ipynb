    "def greet(user_name):\n",
    "\n",
    "    def logged_in(system_name):\n",
    "        print(f\"Welcome {user_name}! You are logged to the {system_name}!\")\n",
    "    \n",
    "    return logged_in\n",
    "\n",
    "alex = greet(\"Alexandra\")\n",
    "daniel = greet(\"Daniel\")\n",
    "\n",
    "alex(\"Linux\")\n",
    "daniel(\"Iphone\")\n",
    "        "
   ]
  }
